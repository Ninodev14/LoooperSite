---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const TAG_COLORS = ['#F6B254', '#BB6EF6', '#3C61F5'];
  const TAG_COLOR_CLASSES = ['orange', 'purple', 'blue'];

  const articles = (await getCollection('ressources', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return articles.map((article, index) => ({
    params: { id: article.id },
    props: {
      article,
      tagColor: TAG_COLORS[index % 3],
      tagColorClass: TAG_COLOR_CLASSES[index % 3],
    },
  }));
}

const { article, tagColor, tagColorClass } = Astro.props;
const { title, description, image, imageLegend, tags, blocks } = article.data;

// Couleurs de flèches pour la FAQ, en boucle
const FAQ_ARROW_COLORS = ['orange', 'purple', 'blue'];

// On sépare les blocs de contenu classiques des blocs FAQ
const contentBlocks = blocks?.filter((block) => block.type !== 'faq') ?? [];
const faqBlocks = blocks?.filter((block) => block.type === 'faq') ?? [];
---

<BaseLayout title={title} description={description}>
  <div class="medium-spacing"></div>

  <div class="container-width ariane-net h3">
    <a href="/">Accueil</a>
    <p class="h3">></p>
    <a href="/ressources/">Nos Ressources</a>
    <p class="h3">></p>
    <a href={''} class={`end-chield highlight-no-annim ${tagColorClass} black-border-small`}
      >{title}</a
    >
  </div>
  <div class="small-medium-spacing"></div>
  <section class="container-width">
    <div class="description-article-container">
      <div class="description-article-content">
        <h1 class="h2 title-intro">{title}</h1>
        <div class="small-spacing"></div>
        <div class="keywords-article-container">
          {
            tags?.map((tag) => (
              <p class="text-typo keywords-article" style={`background-color: ${tagColor};`}>
                {tag}
              </p>
            ))
          }
        </div>
        <div class="small-spacing"></div>
        <figure class="home-article-image" style={`--tag-color: ${tagColor};`}>
          {image && <img src={image} alt={imageLegend || title} />}
        </figure>
        {
          imageLegend && (
            <figcaption class="image-legend image-legend-early text-typo i">
              {imageLegend}
            </figcaption>
          )
        }
        <div class="small-spacing"></div>
        <p class="p">{article.data.description}</p>
      </div>
      <img class="pattern-article" src="/svg/paternArticle.svg" alt="Pattern" />
    </div>
  </section>
  <div class="medium-spacing"></div>
  <div class="zoom-container zoom-container-ressource" style="transform: scaleX(1);">
    <section class="container-width container-article-content">
      {
        contentBlocks.map((block) => {
          switch (block.type) {
            case 'text_single':
              return (
                <section class="block block-text-single">
                  <h2 class="h2 white-border black">{block.heading}</h2>
                  <div set:html={marked.parse(block.text)} />
                  <div class="small-medium-spacing" />
                </section>
              );

            case 'image_text':
              return (
                <section class={`block block-image-text position-${block.imagePosition}`}>
                  <h2 class="h2 white-border black">{block.heading}</h2>
                  <div class="block-image-text-inner">
                    <figure class="block-image-text-image">
                      <img src={block.image} alt={block.imageLegend || block.heading} />
                      {block.imageLegend && (
                        <figcaption class="image-legend text-typo i">
                          {block.imageLegend}
                        </figcaption>
                      )}
                    </figure>
                    <div class="block-image-text-content" set:html={marked.parse(block.text)} />
                  </div>
                  <div class="small-medium-spacing" />
                </section>
              );

            case 'text_two_columns':
              return (
                <section class="block block-two-columns">
                  <h2 class="h2 white-border black">{block.heading}</h2>
                  <div class="columns-grid columns-2">
                    <div set:html={marked.parse(block.column1)} />
                    <div set:html={marked.parse(block.column2)} />
                  </div>
                  <div class="small-medium-spacing" />
                </section>
              );

            case 'full_image_text':
              return (
                <section class="block block-full-image">
                  <h2 class="h2 white-border black">{block.heading}</h2>
                  <figure>
                    <img src={block.image} alt={block.imageLegend || block.heading} />
                    {block.imageLegend && (
                      <figcaption class="image-legend text-typo i">{block.imageLegend}</figcaption>
                    )}
                  </figure>
                  <div set:html={marked.parse(block.text)} />
                  <div class="small-medium-spacing" />
                </section>
              );

            case 'text_three_columns':
              return (
                <section class="block block-three-columns">
                  <h2 class="h2 white-border black">{block.heading}</h2>
                  <div class="columns-grid columns-3">
                    <div set:html={marked.parse(block.column1)} />
                    <div set:html={marked.parse(block.column2)} />
                    <div set:html={marked.parse(block.column3)} />
                  </div>
                  <div class="small-medium-spacing" />
                </section>
              );

            default:
              return null;
          }
        })
      }
    </section>
  </div>

  {
    faqBlocks.map((block) => (
      <>
        <div class="large-spacing" />

        <div class="zoom-container-center faq-article-container">
          <div class="zoom-container background-interogation background-interogation-purple">
            <section class="container-width">
              <h2 class="h2 black">{block.heading}</h2>
              <div class="small-medium-spacing" />
              <div class="wrapper-faq-container-info">
                {block.items?.map((item, index) => {
                  const arrowColor = FAQ_ARROW_COLORS[index % FAQ_ARROW_COLORS.length];
                  return (
                    <div class="wrapper-faq-container-info-row">
                      <article class="faq-container-info">
                        <div class="faq-header">
                          <div>
                            <div class={`faq-arrow faq-arrow-${arrowColor}`}>
                              <div class="faq-arrow-1" />
                              <div class="faq-arrow-2" />
                            </div>
                          </div>
                          <h3 class="h3 black">{item.question}</h3>
                        </div>
                        <div class="black" set:html={marked.parse(item.answer)} />
                      </article>
                    </div>
                  );
                })}
              </div>
            </section>
          </div>
        </div>
      </>
    ))
  }

  <script src="/js/faq.js" defer></script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const schemaOrg = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Loooper!',
    url: 'https://loooper.fr/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Besoins couverts par Loooper!',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: "Rendre l'apprentissage ludique",
        url: 'https://loooper.fr/besoins/apprendre-ludique',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Sensibiliser et faire réfléchir',
        url: 'https://loooper.fr/besoins/sensibiliser-reflechir',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: "Créer de l'interaction sociale",
        url: 'https://loooper.fr/besoins/creer-interaction-sociale',
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: 'Renforcer la cohésion',
        url: 'https://loooper.fr/besoins/renforcer-cohesion',
      },
      {
        '@type': 'ListItem',
        position: 5,
        name: 'Engager et motiver',
        url: 'https://loooper.fr/besoins/engager-motiver',
      },
      {
        '@type': 'ListItem',
        position: 6,
        name: 'Former efficacement',
        url: 'https://loooper.fr/besoins/former-efficacement',
      },
      {
        '@type': 'ListItem',
        position: 7,
        name: 'Marquer les esprits',
        url: 'https://loooper.fr/besoins/marquer-les-esprits',
      },
      {
        '@type': 'ListItem',
        position: 8,
        name: 'Accueillir tous les publics',
        url: 'https://loooper.fr/besoins/accueillir-tous-publics',
      },
    ],
  },
];
---

<BaseLayout
  title="Vos besoins"
  description="Découvrez comment Loooper! utilise la ludification pour répondre à vos besoins : renforcer la cohésion, créer de l'interaction sociale, motiver, former ou marquer les esprits."
  ogImage="https://loooper.fr/img/ico/BESOINS.png"
  ogUrl="https://loooper.fr/besoins"
  currentPage="besoins"
  schemaJson={schemaOrg}>
  <section class="mainPageTitle mainPageTitlePurple" data-reveal="down">
    <h1 class="h1 container-width white-border black">
      Loooper!, des projets qui répondent <span> </span>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleBlue">à </span><span class="paterneTitleContour"
          >à
        </span>
      </div>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleBlue">vos </span><span class="paterneTitleContour"
          >vos
        </span>
      </div>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleBlue">besoins !</span><span
          class="paterneTitleContour">besoins !</span
        >
      </div>
    </h1>
  </section>

  <div class="container-width ariane-net h3" data-reveal="down">
    <a href="/">Accueil </a>
    <p class="h3">></p>
    <a href="/besoins/" class="end-chield highlight-no-annim blue black-border-small">Vos besoins</a
    >
  </div>

  <div class="large-spacing"></div>

  <section class="container-width text-basical-container" data-reveal="up" data-reveal-delay="100">
    <article class="text-basical-container-text-long">
      <div>
        <h2 class="h2 black white-border">
          Former, sensibiliser, fédérer, motiver: des formats ludiques pour chaque besoin
        </h2>
        <div class="small-medium-spacing"></div>
        <p>
          Chez <b>LOOOPER!</b>, tout commence par une question simple : de quoi avez-vous vraiment <b
            class="highlight orange">
            besoin ?</b
          >&thinsp; Nous co-construisons ensemble <b>une expérience interactive sur mesure</b>,
          pensée pour <b class="highlight purple">vos objectifs et vos publics</b>. Chaque<a
            class="link-underline-purple"
            href="/formats/">format</a
          > que nous proposons s'appuie sur des mécaniques de gamification diverses pour répondre à vos
          enjeux. Que ce soit pour de
          <b> la formation, de la sensibilisation, de l'apprentissage ou de la création de lien,</b> notre
          volonté reste la même : transformer vos contenus en expériences ludiques, interactives et mémorables,
          adaptées à <b class="highlight blue">votre contexte et à vos ressources</b>.
        </p>
      </div>
    </article>
    <article class="text-basical-container-emojie">
      <div class="emojie-img-line-container">
        <div class="emojie-img-line">
          <img src="/svg/neonVertion/controler.svg" alt="" />
          <img src="/svg/neonVertion/starType1.svg" alt="" />
        </div>
        <div class="emojie-img-line">
          <img src="/svg/neonVertion/starType2.svg" alt="" />
          <img src="/svg/neonVertion/cardAs.svg" alt="" />
        </div>
      </div>
    </article>
  </section>


---
/**
 * pages/plan-du-site.astro
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Plan du site"
  description="Plan du site Loooper! — retrouvez facilement toutes les pages du site."
  ogUrl="https://loooper.fr/plan-du-site"
  noIndex={true}>
  <section class="mainPageTitle mainPageTitleBlue" data-reveal="down">
    <h1 class="h1 container-width white-border black">
      Plan du<span> </span>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleOrange">site </span><span class="paterneTitleContour"
          >site
        </span>
      </div>
    </h1>
  </section>
  <div class="container-width ariane-net h3" data-reveal="down">
    <a href="/">Accueil</a>
    <p class="h3">></p>
    <a href="/plan-du-site/" class="end-chield highlight-no-annim orange black-border-small"
      >Plan du site</a
    >
  </div>
  <div class="medium-spacing"></div>
  <section class="container-width">
    <article>
      <div class="small-spacing"></div>
      <ul class="spacement-map">
        <li>
          <a href="/" class="text-typo link-underline-purple">Accueil</a>
        </li>
        <li>
          <a href="/formats/" class="text-typo link-underline-purple">Nos formats</a>
        </li>
        <li>
          <a href="/besoins/" class="text-typo link-underline-purple">Vos besoins</a>
        </li>
        <ul class="spacement-map-child">
          <li>
            <a href="/besoins/apprendre-ludique/" class="text-typo link-underline-purple"
              >Rendre l'apprentissage ludique</a
            >
          </li>
          <li>
            <a href="/besoins/sensibiliser-reflechir/" class="text-typo link-underline-purple"
              >Sensibiliser et faire réfléchir</a
            >
          </li>
          <li>
            <a href="/besoins/creer-interaction-sociale/" class="text-typo link-underline-purple"
              >Créer de l'interaction sociale</a
            >
          </li>
          <li>
            <a href="/besoins/renforcer-cohesion/" class="text-typo link-underline-purple"
              >Renforcer la cohésion</a
            >
          </li>
          <li>
            <a href="/besoins/engager-motiver/" class="text-typo link-underline-purple"
              >Engager et motiver</a
            >
          </li>
          <li>
            <a href="/besoins/former-efficacement/" class="text-typo link-underline-purple"
              >Former efficacement</a
            >
          </li>
          <li>
            <a href="/besoins/marquer-les-esprits/" class="text-typo link-underline-purple"
              >Marquer les esprits</a
            >
          </li>
          <li>
            <a href="/besoins/accueillir-tous-publics/" class="text-typo link-underline-purple"
              >Accueillir tous les publics</a
            >
          </li>
        </ul>
        <li>
          <a href="/votre-secteur/" class="text-typo link-underline-purple">Votre secteur</a>
        </li>
        <ul class="spacement-map-child">
          <li>
            <a href="/secteur/serious-game-musee/" class="text-typo link-underline-purple"
              >Musées et patrimoine</a
            >
          </li>
          <li>
            <a href="/secteur/serious-game-ecole/" class="text-typo link-underline-purple"
              >Écoles et éducation</a
            >
          </li>
          <li>
            <a href="/secteur/jeu-entreprise-rse/" class="text-typo link-underline-purple"
              >Entreprises et RSE</a
            >
          </li>
          <li>
            <a href="/secteur/jeu-interactif-tourisme/" class="text-typo link-underline-purple"
              >Tourisme et territoires</a
            >
          </li>
          <li>
            <a href="/secteur/jeu-interactif-zoo/" class="text-typo link-underline-purple"
              >Zoos et parcs animaliers</a
            >
          </li>
        </ul>
        <li>
          <a href="/equipe/" class="text-typo link-underline-purple">Notre équipe</a>
        </li>
        <li>
          <a href="/projets/" class="text-typo link-underline-purple">Nos projets</a>
        </li>
        <li>
          <a href="/ressources/" class="text-typo link-underline-purple">Ressources</a>
        </li>
      </ul>
    </article>
  </section>
</BaseLayout>

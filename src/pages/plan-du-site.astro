---
/**
 * pages/plan-du-site.astro
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Plan du site"
  description="Plan du site Loooper! — retrouvez facilement toutes les pages du site."
  ogUrl="https://loooper.fr/plan-du-site"
  noIndex={true}>
  <section class="mainPageTitle mainPageTitleBlue" data-reveal="down">
    <h1 class="h1 container-width white-border black">
      Plan du<span> </span>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleOrange">site </span><span class="paterneTitleContour"
          >site
        </span>
      </div>
    </h1>
  </section>
  <div class="container-width ariane-net h3" data-reveal="down">
    <a href="/">Accueil</a>
    <p class="h3">></p>
    <a href="/plan-du-site/" class="end-chield highlight-no-annim orange black-border-small"
      >Plan du site</a
    >
  </div>
  <div class="medium-spacing"></div>
  <section class="container-width">
    <article>
      <div class="small-spacing"></div>
      <ul class="spacement-map">
        <li>
          <a href="/" class="text-typo link-underline">Accueil</a>
        </li>
        <li>
          <a href="/formats/" class="text-typo link-underline">Nos formats</a>
        </li>
        <li>
          <a href="/besoins/" class="text-typo link-underline">Vos besoins</a>
        </li>
        <ul class="spacement-map-child">
          <li>
            <a href="/apprendre-ludique/" class="text-typo">Apprendre avec le ludique</a>
          </li>
          <li>
            <a href="/sensibiliser-reflechir/" class="text-typo">Sensibiliser et faire réfléchir</a>
          </li>
          <li>
            <a href="/creer-interaction-sociale/" class="text-typo"
              >Créer de l'interaction sociale</a
            >
          </li>
          <li>
            <a href="/renforcer-cohesion/" class="text-typo">Renforcer la cohésion</a>
          </li>
          <li>
            <a href="/engager-motiver/" class="text-typo">Engager et motiver</a>
          </li>
          <li>
            <a href="/former-efficacement/" class="text-typo">Former efficacement</a>
          </li>
          <li>
            <a href="/communiquer-autrement/" class="text-typo">Communiquer autrement</a>
          </li>
        </ul>
        <li>
          <a href="/equipe/" class="text-typo link-underline">Notre équipe</a>
        </li>
        <li>
          <a href="/projets/" class="text-typo link-underline">Nos projets</a>
        </li>
      </ul>
    </article>
  </section>
</BaseLayout>

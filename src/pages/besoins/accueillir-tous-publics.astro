---
/**
 * pages/accueillir-tous-publics.astro — Accueillir tous les publics
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/Modal/Quiz.astro';
import JeuSociete from '../../components/Modal/JeuSociete.astro';
import GeoCaching from '../../components/Modal/Geocaching.astro';
---

<BaseLayout
  title="Accueillir tous les publics"
  description="Handicap, âge, niveau de lecture, contexte : Loooper! adapte chaque expérience ludique à vos publics pour que personne ne reste sur le côté."
  ogUrl="https://loooper.fr/accueillir-tous-publics"
  currentPage="accueillir-tous-publics"
  ><section class="mainPageTitle mainPageTitleBlue" data-reveal="down">
    <h1 class="h1 container-width white-border black">
      Loooper! c’est accueillir <span> </span>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleOrange">tous </span><span class="paterneTitleContour"
          >tous
        </span>
      </div>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleOrange">les </span><span class="paterneTitleContour"
          >les
        </span>
      </div>
      <div class="paterneTitleContainer">
        <span class="paterneTitle paterneTitleOrange">publics !</span><span
          class="paterneTitleContour">publics !</span
        >
      </div>
    </h1>
  </section>
  <div class="container-width ariane-net h3" data-reveal="down">
    <a href="/">Accueil </a>
    <p class="h3">></p>
    <a href="/besoins/">Vos besoins</a>
    <p class="h3">></p>
    <a
      href="/besoins/accueillir-tous-publics/"
      class="end-chield highlight-no-annim orange black-border-small">
      Accueillir tous les publics
    </a>
  </div>

  <div class="large-spacing"></div>

  <section class="container-width text-basical-container" data-reveal="up" data-reveal-delay="100">
    <article class="text-basical-container-text-long">
      <div>
        <h2 class="h2 black white-border">Une expérience qui s’adapte à vos publics</h2>
        <div class="small-medium-spacing"></div>

        <p>
          Chez <b>Loooper!</b>, il n’y a pas de solution toute faite : <b class="highlight orange"
            >nous nous adaptons à vous</b
          >, à <b class="highlight purple">votre public</b> et à ses <b>besoins</b>, y compris en
          situation de <b class="highlight blue">handicap</b>. Visuel, auditif, moteur, cognitif, ou
          simplement des habitudes de lecture et de jeu différentes : <b
            >chaque expérience est pensée pour être accessible</b
          >. Police adaptée, contraste, repères sonores, concentration, format physique ou
          numérique… ce ne sont que
          <b>des exemples parmi d’autres</b>. Ensemble, nous définissons ce qui compte vraiment pour
          vos joueurs.
        </p>
      </div>
    </article>
    <article class="text-basical-container-emojie">
      <div class="emojie-img-line-container-besoin-child">
        <div class="emojie-img-line-besoin-child star">
          <img src="/svg/neonVertion/starPurpleType2.svg" alt="" />
        </div>
        <img class="emojie-img-line-besoin-child" src="/svg/neonVertion/multipleGuy.svg" alt="" />
        <div class="emojie-img-line-besoin-child star2">
          <img src="/svg/neonVertion/starPurpleType1.svg" alt="" />
        </div>
      </div>
    </article>
  </section>

  <div class="large-spacing"></div>

  <div class="backgroundBrushType1">
    <section class="container-width long-card-container" data-reveal="up" data-reveal-delay="100">
      <h2 class="h2 black white-border">Des formats adaptables à chaque public</h2>
      <div class="small-medium-spacing"></div>
      <div class="long-card-wrapper">
        <article class="long-card long-card-orange">
          <img
            src="/img/long-card/cart-cartel.jpg"
            alt="Écran du quiz Cartes & Cartels avec de grands textes contrastés"
          />
          <div class="long-card-text-content">
            <div>
              <h3
                class="h2 black white-border highlight-no-annim orange"
                id="accessibilite-part-1-container-title">
                Quiz
              </h3>
            </div>
            <p class="black">
              Lecture, <b>contrastes</b>, <b>sons</b>, <b>rythme</b>, <b>niveau de difficulté</b> : chaque
              réglage peut être pensé <b>pour vos joueurs</b>, sur écran ou en direct.
            </p>
            <button
              data-modal="modal-quiz"
              aria-haspopup="dialog"
              class="text-typo btn-project btn-modal btn-white-background"
              aria-label="En savoir plus sur le quiz">
              <span>En savoir plus</span>
            </button>
          </div>
        </article>

        <article class="long-card long-card-purple">
          <img
            src="/img/long-card/geocaching.jpg"
            alt="Écran d'une carte de Bordeaux avec plusieurs points de repère, illustrant un géocaching"
          />
          <div class="long-card-text-content">
            <div>
              <h3
                class="h2 black white-border highlight-no-annim purple"
                id="accessibilite-part-2-container-title">
                Géocaching
              </h3>
            </div>
            <p class="black">
              <b>Lieu, parcours, étapes, durée</b> : tout se règle selon <b
                >la mobilité et les capacités</b
              > de votre groupe, pour explorer ensemble.
            </p>
            <button
              data-modal="modal-geocaching"
              aria-haspopup="dialog"
              class="text-typo btn-project btn-modal btn-white-background"
              aria-label="En savoir plus sur le Géocaching">
              <span>En savoir plus</span>
            </button>
          </div>
        </article>

        <article class="long-card long-card-blue">
          <img
            src="/img/long-card/biker.jpg"
            alt="Personnes jouant au jeu de société Bikers au Grand Cœur"
          />
          <div class="long-card-text-content">
            <div>
              <h3
                class="h2 black white-border highlight-no-annim blue"
                id="accessibilite-part-3-container-title">
                Jeu de société
              </h3>
            </div>
            <p class="black">
              <b>Règles, matériel, rôles</b> : on ajuste le jeu pour que
              <b>chacun puisse y participer</b> et prendre la parole à sa façon.
            </p>
            <button
              data-modal="modal-jeu-societe"
              aria-haspopup="dialog"
              class="text-typo btn-project btn-modal btn-white-background"
              aria-label="En savoir plus sur les Jeu de société">
              <span>En savoir plus</span>
            </button>
          </div>
        </article>
      </div>
      <div class="small-medium-spacing"></div>
      <a href="/formats/" class="text-typo btn-project btn-white-background">
        <span>Découvrir nos autres formats</span>
      </a>
    </section>
  </div>

  <div class="large-spacing"></div>

  <div class="zoom-container-center">
    <div class="zoom-container background-interogation background-interogation-purple">
      <section class="container-width">
        <h2 class="h2 black">Des questions sur l’accessibilité ?</h2>
        <div class="small-medium-spacing"></div>
        <div class="wrapper-faq-container-info">
          <div class="wrapper-faq-container-info-row">
            <article class="faq-container-info">
              <div class="faq-header">
                <div>
                  <div class="faq-arrow faq-arrow-orange">
                    <div class="faq-arrow-1"></div>
                    <div class="faq-arrow-2"></div>
                  </div>
                </div>
                <h3 class="h3 black">À quels publics et handicaps vous adaptez-vous ?</h3>
              </div>
              <p class="black">
                <b>À celui de vos joueurs.</b> Handicap visuel, auditif, moteur, cognitif, troubles de
                l’attention, difficultés de lecture, âge, familiarité avec le numérique… Nous partons
                de <b>votre public réel</b>, pas d’un modèle figé.
              </p>
            </article>

            <article class="faq-container-info">
              <div class="faq-header">
                <div>
                  <div class="faq-arrow faq-arrow-purple">
                    <div class="faq-arrow-1"></div>
                    <div class="faq-arrow-2"></div>
                  </div>
                </div>
                <h3 class="h3 black">Quels aménagements peut-on prévoir ?</h3>
              </div>
              <p class="black">
                Ils dépendent <b>de vos besoins</b> : typographie, contrastes, sons, consignes, rythme,
                support numérique ou physique… Dites-nous
                <a class="link-underline-purple" href="/besoins/">qui vous voulez accueillir</a>,
                nous trouvons <b>les bons réglages ensemble</b>.
              </p>
            </article>
          </div>
          <div class="wrapper-faq-container-info-row">
            <article class="faq-container-info">
              <div class="faq-header">
                <div>
                  <div class="faq-arrow faq-arrow-blue">
                    <div class="faq-arrow-1"></div>
                    <div class="faq-arrow-2"></div>
                  </div>
                </div>
                <h3 class="h3 black">Comment construisez-vous une expérience accessible ?</h3>
              </div>
              <p class="black">
                En <b>coconstruction</b> : on écoute, on teste, on ajuste jusqu’à ce que l’expérience
                <b>fonctionne pour tous vos publics</b>.
              </p>
            </article>

            <article class="faq-container-info">
              <div class="faq-header">
                <div>
                  <div class="faq-arrow faq-arrow-orange">
                    <div class="faq-arrow-1"></div>
                    <div class="faq-arrow-2"></div>
                  </div>
                </div>
                <h3 class="h3 black">
                  Peut-on réunir des publics différents autour d’un même jeu ?
                </h3>
              </div>
              <p class="black">
                Oui, c’est même l’objectif : <b>favoriser les rencontres</b> et aider chacun à
                <b>apprendre autrement</b>. Parmi
                <a class="link-underline-purple" href="/formats/">tous nos formats</a>, nous
                choisissons celui qui donne <b>à chacun un rôle à jouer</b>.
              </p>
            </article>
          </div>
        </div>
      </section>
    </div>
  </div>

  <Quiz />
  <JeuSociete />
  <GeoCaching />

  <script src="/js/modal.js" defer></script>
  <script src="/js/faq.js" defer></script>
</BaseLayout>
